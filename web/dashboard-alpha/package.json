{
  "name": "watchtower-dashboard-alpha",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-wiki.mjs && vite --port 8081 --strictPort",
    "build": "node scripts/build-wiki.mjs && tsc -b && vite build && node scripts/copy-static-assets.mjs",
    "build:wiki": "node scripts/build-wiki.mjs",
    "preview": "node scripts/build-wiki.mjs && node scripts/apply-alpha-profile.mjs normal && vite --port 8081 --strictPort",
    "preview:fresh": "node scripts/build-wiki.mjs && node scripts/apply-alpha-profile.mjs fresh && vite --port 8081 --strictPort",
    "preview:live": "node scripts/build-wiki.mjs && vite --port 8081 --strictPort --mode live",
    "generate:mock": "node scripts/generate-mock-data.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "test:logs": "tsx --test src/features/logs/parse-mc-log.test.ts",
    "test:mods": "tsx --test src/features/mods/*.test.ts",
    "audit:packaging": "node ../../tools/audit-dashboard-alpha-packaging.mjs",
    "audit:parity": "node ../../tools/audit-dashboard-alpha-parity.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@number-flow/react": "^0.6.2",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-virtual": "^3.14.8",
    "@visx/curve": "^4.0.1-alpha.0",
    "@visx/event": "^4.0.1-alpha.0",
    "@visx/gradient": "^4.0.1-alpha.0",
    "@visx/grid": "^4.0.1-alpha.0",
    "@visx/group": "^4.0.1-alpha.0",
    "@visx/heatmap": "^4.0.1-alpha.0",
    "@visx/pattern": "^4.0.1-alpha.0",
    "@visx/responsive": "^4.0.1-alpha.0",
    "@visx/scale": "^4.0.1-alpha.0",
    "@visx/shape": "^4.0.1-alpha.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "lucide-animated": "^1.0.5",
    "lucide-react": "^0.525.0",
    "motion": "^12.42.2",
    "ogl": "^1.0.11",
    "radix-ui": "^1.6.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-use-measure": "^2.1.7",
    "shadcn": "^4.14.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^24.0.14",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.23.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
