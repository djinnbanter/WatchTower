  "deepLinks": [
    {
      "id": "docs-article",
      "template": "/?tab=docs&wiki={wikiSlug}",
      "parameter": "wiki",
      "values": [
        "Home",
        "Installation",
        "Quick-Start-Checklist",
        "Dashboard-Overview",
        "Dashboard-Tabs",
        "Understanding-Data-Sources",
        "Using-Spark-with-Watchtower",
        "Live-Charts",
        "Commands",
        "Configuration",
        "Crash-Rule-Packs",
        "Security-and-Access",
        "Hosting-Panels",
        "Reading-Metrics-on-Hosted-Servers",
        "Health-Reports",
        "Backups",
        "Scheduled-Reports",
        "Disaster-Recovery",
        "DR-CLI-Reference",
        "DR-Viewer",
        "HTTP-API",
        "On-disk-Files",
        "Troubleshooting",
        "Downloads-and-Releases",
        "Roadmap",
        "Changelog"
      ]
    },
    {
      "id": "issue",
      "template": "/?tab=issues&view={view}&issue={issueKey}",
      "parameters": [
        "view",
        "issue"
      ],
      "example": "/?tab=issues&view=active&issue=TICK_LAG"
    },
    {
      "id": "crash-group",
      "template": "/?tab=crashes&view={view}&group={fingerprint}",
      "parameters": [
        "view",
        "group"
      ]
    },
    {
      "id": "mod",
      "template": "/?tab=mods&view={view}&mod={modId}",
      "parameters": [
        "view",
        "mod"
      ],
      "example": "/?tab=mods&view=overview&mod=create"
    },
    {
      "id": "spark-profile",
      "template": "/?tab=spark&profile={sourcePath}",
      "parameter": "profile",
      "example": "/?tab=spark&profile=watchtower%2Fspark-upload%2FVBK9P8wiBc.sparkprofile"
    }
  ],
  "legacyAliases": [
    {
      "route": "/?tab=performance",
      "resolvesTo": "insights"
    },
    {
      "route": "/?settings=security",
      "resolvesTo": "settings/security"
    },
    {
      "route": "/?help=1",
      "resolvesTo": "docs"
    },
    {
      "route": "/?tab=help",
      "resolvesTo": "docs"
    },
    {
      "route": "/?tab=wizard",
      "resolvesTo": "overview"
    },
    {
      "route": "/?tab=lab",
      "resolvesTo": "overview"
    },
    {
      "route": "/?setup=1",
      "resolvesTo": "overview?setup=1"
    }
  ]
