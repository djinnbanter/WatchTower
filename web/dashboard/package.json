{
  "name": "watchtower-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-wiki.mjs && vite --port 8081 --strictPort",
    "build": "node scripts/build-wiki.mjs && tsc -b && vite build && node scripts/copy-static-assets.mjs",
    "build:wiki": "node scripts/build-wiki.mjs",
    "preview": "node scripts/build-wiki.mjs && node scripts/apply-preview-profile.mjs normal && vite --port 8081 --strictPort",
    "preview:create-smp": "node scripts/preview-create-smp.mjs",
    "preview:fresh": "node scripts/build-wiki.mjs && node scripts/apply-preview-profile.mjs fresh && vite --port 8081 --strictPort",
    "preview:live": "node scripts/build-wiki.mjs && vite --port 8081 --strictPort --mode live",
    "generate:mock": "node scripts/generate-mock-data.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "test:demo": "tsx --test scripts/fixture-api-core.test.ts src/api/demo-key.test.ts src/api/client.demo.test.ts src/app/runtime.test.ts",
    "bake:demo": "tsx scripts/bake-demo-api.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "vercel-build": "npm run build:demo",
    "check:demo": "node scripts/check-demo-manifest.mjs",
    "smoke:demo": "node scripts/smoke-demo.mjs",
    "test:logs": "tsx --test src/features/logs/parse-mc-log.test.ts",
    "test:mods": "tsx --test src/features/mods/*.test.ts",
    "test:digest": "tsx --test src/features/insights/weekly-digest.test.ts",
    "test:storage": "tsx --test src/features/insights/panels/storage-treemap-tree.test.ts src/features/insights/panels/storage-treemap-format.test.ts",
    "test:issues": "tsx --test src/features/issues/helpers.test.ts",
    "test:spark-map": "tsx --test src/features/spark/map-helpers.test.ts",
    "test:session": "tsx --test src/features/session/*.test.ts",
    "test:settings": "tsx --test src/app/permissions.test.ts src/app/permissions-mutate.test.ts src/app/session-store.test.ts src/app/accents.test.ts src/features/wizard/persist.test.ts src/ui/player-avatar.test.ts src/features/settings/audit-log-helpers.test.ts",
    "test:ui-consistency": "tsx --test scripts/ui-consistency-banlist.test.ts",
    "audit:packaging": "node ../../tools/audit-dashboard-packaging.mjs",
    "audit:parity": "node ../../tools/audit-dashboard-parity.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@number-flow/react": "^0.6.2",
    "@shadcn/react": "^0.3.0",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-table": "^9.1.2",
    "@tanstack/react-virtual": "^3.14.8",
    "@visx/curve": "^4.0.1-alpha.0",
    "@visx/event": "^4.0.1-alpha.0",
    "@visx/gradient": "^4.0.1-alpha.0",
    "@visx/grid": "^4.0.1-alpha.0",
    "@visx/group": "^4.0.1-alpha.0",
    "@visx/heatmap": "^4.0.1-alpha.0",
    "@visx/pattern": "^4.0.1-alpha.0",
    "@visx/responsive": "^4.0.1-alpha.0",
    "@visx/scale": "^4.0.1-alpha.0",
    "@visx/shape": "^4.0.1-alpha.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3-array": "^3.2.4",
    "d3-hierarchy": "^3.1.2",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "html-to-image": "^1.11.13",
    "input-otp": "^1.4.2",
    "lucide-animated": "^1.0.5",
    "lucide-react": "^0.525.0",
    "motion": "^12.42.2",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.1.0",
    "react-resizable-panels": "^4.12.2",
    "react-use-measure": "^2.1.7",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^24.0.14",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "shadcn": "^4.14.0",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.23.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
